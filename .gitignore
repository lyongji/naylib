# Build artifacts
*.o
*.a
*.so
*.dll
*.exe
nimcache/

*.nimble_link

# Dependencies (Atlas installs these at the repo root; do not ignore nested
# source dirs such as src/raylib/external/glfw/deps or RGFW/deps)
/deps/
/nimbledeps/

.env
.venv

# Raylib source (only the update task's clone at the repo root; the bundled
# sources live in src/raylib and MUST stay tracked)
/raylib/

# Compiled tools
tools/mangler/naylib_mangler
tools/parser/raylib_parser
tools/wrapper/naylib_wrapper

# Configuration
/nim.cfg

